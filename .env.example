# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to 3000
PORT=3000

# Optional — defaults to claude-sonnet-5. Try claude-opus-5 for tougher
# comparisons, or claude-haiku-4-5-20251001 for faster/cheaper checks.
# CLAUDE_MODEL=claude-sonnet-5

# Optional — shared password (HTTP Basic). Without it, anyone who can reach
# the server can spend your API credit. Required for a public deployment.
# APP_PASSWORD=

# Optional — set to 1 only when a load balancer sets X-Forwarded-For.
# TRUST_PROXY=1

# Optional — bind address. 127.0.0.1 keeps it off your local network.
# HOST=127.0.0.1

# Optional. Unlocks exact brick codes: when a user uploads an instruction page
# and the set number is printed on it, the set's real inventory is fetched and
# each missing/wrong piece is matched to a part from that inventory. Without
# this the app still reads the set number and links out to the parts list, but
# names no codes — it will not guess them. Free key: rebrickable.com/api
# REBRICKABLE_API_KEY=
