#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/brickcheck-setup.log) 2>&1

# Runs once, on first boot.

dnf update -y
dnf install -y docker git

systemctl enable --now docker
usermod -aG docker ec2-user

# Secrets come from SSM using the instance role, so they never appear in
# Terraform state, in user-data, or in the AMI.
API_KEY="$(aws ssm get-parameter --name '${api_key_parameter}' --with-decryption --region '${region}' --query 'Parameter.Value' --output text)"

# With require_password off the app is deliberately public: APP_PASSWORD is
# left unset rather than blank, because the server treats any non-empty value
# as a password to enforce.
REQUIRE_PASSWORD='${require_password}'
if [ "$REQUIRE_PASSWORD" = "true" ]; then
  APP_PASSWORD="$(aws ssm get-parameter --name '${app_password_parameter}' --with-decryption --region '${region}' --query 'Parameter.Value' --output text)"
else
  APP_PASSWORD=""
fi

# Optional. Absent, the app runs exactly as before and simply names no brick
# codes, so a missing parameter must not abort this script (set -e is on).
REBRICKABLE_API_KEY="$(aws ssm get-parameter --name '${rebrickable_parameter}' --with-decryption --region '${region}' --query 'Parameter.Value' --output text 2>/dev/null || true)"
if [ "$REBRICKABLE_API_KEY" = "None" ]; then REBRICKABLE_API_KEY=""; fi

# Caddy needs a hostname to get a certificate for. With no domain of your own,
# fall back to sslip.io, which resolves <ip>.sslip.io straight to <ip> — good
# enough for Let's Encrypt to issue a real, publicly trusted certificate.
SITE='${domain}'
if [ -z "$SITE" ]; then
  # Prefer the Elastic IP passed in by Terraform. Reading the address from
  # instance metadata instead would pick up the temporary one the box boots
  # with, and the certificate would be issued for a hostname that stops
  # resolving here the moment the Elastic IP is associated.
  FIXED_IP='${fixed_ip}'
  if [ -n "$FIXED_IP" ]; then
    SITE="$FIXED_IP.sslip.io"
  else
    # IMDSv2 is required on this instance, so fetch a token first.
    TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
    PUBLIC_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4)
    SITE="$PUBLIC_IP.sslip.io"
  fi
fi
echo "serving as $SITE"

install -m 600 /dev/null /etc/brickcheck.env
cat > /etc/brickcheck.env <<EOF
ANTHROPIC_API_KEY=$API_KEY
APP_PASSWORD=$APP_PASSWORD
REBRICKABLE_API_KEY=$REBRICKABLE_API_KEY
FEEDBACK_BUCKET=${feedback_bucket}
AWS_REGION=${region}
# Correct here: Caddy terminates TLS and sets X-Forwarded-For, and the app
# container publishes no host port, so requests cannot arrive any other way.
TRUST_PROXY=1
EOF
chmod 600 /etc/brickcheck.env

git clone '${repo_url}' /opt/brickcheck
cd /opt/brickcheck
docker build -t brickcheck .

# Private network between Caddy and the app. The app deliberately publishes
# no host port — if it did, anyone could reach it directly on :3000 and forge
# X-Forwarded-For to walk past the rate limit.
docker network create brickcheck 2>/dev/null || true

mkdir -p /etc/caddy
cat > /etc/caddy/Caddyfile <<EOF
$SITE {
	reverse_proxy brickcheck:3000 {
		transport http {
			# Analyses run to about a minute; the default would cut them off.
			read_timeout 300s
		}
	}
}
EOF

cat > /etc/systemd/system/brickcheck.service <<'EOF'
[Unit]
Description=BrickCheck
After=docker.service
Requires=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f brickcheck
ExecStart=/usr/bin/docker run --rm --name brickcheck \
  --network brickcheck \
  --env-file /etc/brickcheck.env brickcheck
ExecStop=/usr/bin/docker stop brickcheck

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/caddy.service <<'EOF'
[Unit]
Description=Caddy TLS terminator for BrickCheck
After=docker.service brickcheck.service
Requires=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f caddy
ExecStart=/usr/bin/docker run --rm --name caddy \
  --network brickcheck \
  -p 80:80 -p 443:443 \
  -v /etc/caddy/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v caddy_data:/data -v caddy_config:/config \
  caddy:2
ExecStop=/usr/bin/docker stop caddy

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now brickcheck
systemctl enable --now caddy

# Surface the lines that matter in the setup log, so a failed Python layer or
# a certificate problem is visible without going hunting.
sleep 25
echo "--- app ---"
docker logs brickcheck 2>&1 | tail -20 || true
echo "--- caddy ---"
docker logs caddy 2>&1 | tail -20 || true
echo "--- reachable over https? ---"
if [ -n "$APP_PASSWORD" ]; then EXPECT="401 expected: TLS is up and the password gate is on"
else EXPECT="200 expected: TLS is up and the site is deliberately public"; fi
curl -sS -o /dev/null -w "https://$SITE/ -> %%{http_code} ($EXPECT)\n" "https://$SITE/" || true
